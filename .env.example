# Copiez ce fichier en .env puis adaptez les valeurs.
# Ne jamais committer le vrai .env (il contient les secrets).

# Django
SECRET_KEY=changez-moi-par-une-cle-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de donnees PostgreSQL (instance locale du projet, port 5433)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=redafrik
DB_USER=redafrik
DB_PASSWORD=changez-moi
DB_HOST=localhost
DB_PORT=5433

# CORS (dev : tout autoriser ; prod : lister les origines exactes du frontend)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://redafrik.example.com

# URL publique du frontend (liens reçus par e-mail)
FRONTEND_URL=http://localhost:8000

# E-mails transactionnels (console en dev ; SMTP en prod)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=changez-moi
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=RedAfrik <no-reply@redafrik.app>

# Journal des actions (traçabilité IP + géolocalisation)
JOURNAL_ACTIONS_ENABLED=True
JOURNAL_RETENTION_JOURS=90
# Adresses des proxies autorisés à transmettre l'IP réelle (X-Forwarded-For)
# TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
# Base GeoLite2 (MaxMind) pour la géolocalisation — voir README
# GEOIP_DB_PATH=data/GeoLite2-City.mmdb

# Logs structurés JSON (stdout en dev ; fichier en prod avec rotation)
# LOG_FILE_PATH=/var/log/redafrik/json.log
# DJANGO_LOG_LEVEL=INFO

# Sécurité production (uniquement pris en compte si DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
