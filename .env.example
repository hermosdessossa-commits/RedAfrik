# Copiez ce fichier en .env puis adaptez les valeurs.
# Ne jamais committer le vrai .env (il contient les secrets).

# Django
SECRET_KEY=changez-moi-par-une-cle-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de donnees PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=redafrik
DB_USER=redafrik
DB_PASSWORD=changez-moi
DB_HOST=localhost
DB_PORT=5432

# CORS (dev : tout autoriser ; prod : lister les origines exactes du frontend)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://redafrik.example.com

# Sécurité production (uniquement pris en compte si DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
